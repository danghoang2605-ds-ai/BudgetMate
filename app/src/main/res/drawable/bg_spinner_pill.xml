<?xml version="1.0" encoding="utf-8"?>
<!-- Pill with a chevron, replacing the platform spinner underline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/bm_surface" />
            <stroke android:width="1dp" android:color="@color/bm_hairline_2" />
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:end="10dp" android:width="18dp" android:height="18dp"
        android:drawable="@drawable/ms_expand_more_gold" />
</layer-list>
