<?xml version="1.0" encoding="utf-8"?>
<!-- Brief brand moment: the app icon, the wordmark and one honest line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bm_bg"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_splash_icon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@mipmap/ic_launcher"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tv_splash_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="BudgetMate"
        android:textColor="@color/bm_text"
        android:textSize="34sp"
        android:fontFamily="@font/manrope_extrabold"
        android:letterSpacing="-0.02" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Your money, logged in seconds"
        android:textColor="@color/bm_muted"
        android:textSize="15sp" />

</LinearLayout>
