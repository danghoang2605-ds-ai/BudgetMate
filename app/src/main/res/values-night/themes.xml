<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BudgetMate" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#D4AF37</item>
        <item name="colorPrimaryVariant">#0A1128</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#14B8A6</item>
        <item name="colorSecondaryVariant">#1E293B</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">#0A1128</item>
        <item name="android:navigationBarColor">#0B1226</item>
        <item name="android:windowBackground">@color/bm_bg</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
        <item name="textAppearanceButton">@style/BMButtonText</item>
        <item name="materialButtonStyle">@style/BMButton</item>
    </style>

    <!-- Buttons: Manrope, sentence case (Material defaults to all caps). -->
    <style name="BMButtonText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="BMButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAppearance">@style/BMButtonText</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="BMNavText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="BMTabText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="NumPadButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">#111827</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="CalendarDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="background">@color/ui_solid_calendar_bg</item>
        <item name="colorSurface">@color/ui_solid_calendar_bg</item>

        <item name="colorPrimary">#D4AF37</item>
        <item name="colorAccent">#D4AF37</item>

        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@color/ui_muted_gray</item>

        <item name="buttonBarPositiveButtonStyle">@style/CalendarDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/CalendarDialogButtonStyle</item>
    </style>

    <style name="CalendarDialogButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#D4AF37</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomDatePickerTheme" parent="CalendarDialogTheme">
    </style>

    <style name="BMKeypadDigit" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_keypad_btn</item>
        <item name="android:textColor">@color/bm_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@animator/keypad_press</item>
    </style>

</resources>